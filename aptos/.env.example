# Aptos Configuration
# Copy this to .env and fill in your values

# Network: testnet, mainnet, or devnet
APTOS_NETWORK=testnet

# Your private key (hex format, without 0x prefix)
APTOS_PRIVATE_KEY=

# Your public key (optional)
APTOS_PUBLIC_KEY=

# Contract publisher address
PUBLISHER_ADDRESS=

# Gas price in microAPT
GAS_PRICE=100
